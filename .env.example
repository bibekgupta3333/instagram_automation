# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# Placeholders only below.

# --- LLM backend (studio/llm) ----------------------------------------------
# bedrock (default) | claude-code (`claude -p`, uses your Claude subscription limits)
# | gateway (LiteLLM, infra/litellm/config.yaml) | ollama (optional, local) | mock
STUDIO_LLM=bedrock
# Monthly Bedrock cap in USD (infra/LLM_COSTS.md: ~$23.50 expected at full scale)
STUDIO_BEDROCK_MONTHLY_USD=30
# Optional per-role model override, e.g. STUDIO_BEDROCK_MODEL_DRAFT=us.anthropic.claude-haiku-5-5
# STUDIO_BEDROCK_MODEL_DRAFT=
# LiteLLM proxy (only with STUDIO_LLM=gateway; make gateway)
LITELLM_BASE_URL=http://localhost:4000
# Optional: Ollama, only with STUDIO_LLM=ollama (bulk roles only). Keep it on localhost.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Publishing -------------------------------------------------------------
BUFFER_API_KEY=your-buffer-api-key
# OAuth client secrets JSON downloaded from Google Cloud Console (keep it outside the repo)
YOUTUBE_CLIENT_SECRETS_PATH=/path/to/client_secret.json

# --- AWS (Bedrock, S3/CDN) --------------------------------------------------
# Bedrock API key; must come from a personal AWS account, never an employer account
AWS_BEARER_TOKEN_BEDROCK=
# Fallback when no API key is set: use a personal AWS account — not an employer profile
AWS_PROFILE=
AWS_REGION=us-east-1

# --- Stock media / avatars --------------------------------------------------
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key
HEYGEN_API_KEY=your-heygen-api-key

# --- Output -----------------------------------------------------------------
# Public, NON-expiring base URL that serves rendered media (platforms fetch from it;
# pre-signed URLs that expire will break scheduled posts). No trailing slash.
CDN_PUBLIC_BASE_URL=https://cdn.example.com/studio
STUDIO_OUTPUT_DIR=output
