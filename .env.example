# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# Placeholders only below.

# --- LLM backend (studio/llm) ----------------------------------------------
# bedrock (default) | claude-code (`claude -p`, uses your Claude subscription limits)
# | gateway (LiteLLM, infra/litellm/config.yaml) | ollama (optional, local) | mock
STUDIO_LLM=bedrock
# Monthly Bedrock cap in USD (infra/LLM_COSTS.md: ~$23.50 expected at full scale)
STUDIO_BEDROCK_MONTHLY_USD=30

# --- Bedrock TEXT models (fill in your model IDs; empty = built-in default) ---
# Bedrock is used for TEXT only (scripts, metadata, polish, fact-check); no images or video.
# Any id form: base id (anthropic.claude-...), cross-Region profile (us./eu./apac./global.)
# or a full inference-profile ARN. Precedence: per-role > tier > built-in default.
BEDROCK_MODEL_ID_FAST=        # drafts, metadata, ideation (e.g. Haiku-class)
BEDROCK_MODEL_ID_QUALITY=     # polish + fact-check (e.g. Sonnet-class)
BEDROCK_MODEL_ID_ESCALATION=  # disputed claims (e.g. Opus-class)
# optional per-role overrides: STUDIO_BEDROCK_MODEL_DRAFT=, STUDIO_BEDROCK_MODEL_FACT_CHECK=, ...
# Optional exact prices (USD per 1M tokens) for a non-Claude tier model; else inferred from the id
# BEDROCK_PRICE_IN_PER_MTOK_FAST=
# BEDROCK_PRICE_OUT_PER_MTOK_FAST=
# (same for _QUALITY and _ESCALATION)
# Optional: off = always prompt for JSON instead of tool use (auto-detected by default)
# STUDIO_BEDROCK_TOOL_USE=

# LiteLLM proxy (only with STUDIO_LLM=gateway; make gateway)
LITELLM_BASE_URL=http://localhost:4000
# Optional: Ollama, only with STUDIO_LLM=ollama (bulk roles only). Keep it on localhost.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Publishing -------------------------------------------------------------
BUFFER_API_KEY=your-buffer-api-key
# OAuth client secrets JSON downloaded from Google Cloud Console (keep it outside the repo)
YOUTUBE_CLIENT_SECRETS_PATH=/path/to/client_secret.json

# --- AWS (Bedrock, S3/CDN) --------------------------------------------------
# Bedrock API key; must come from a personal AWS account, never an employer account
AWS_BEARER_TOKEN_BEDROCK=
# Fallback when no API key is set: use a personal AWS account — not an employer profile
AWS_PROFILE=
AWS_REGION=us-east-1

# --- Stock media (free; studio/stages/visuals/pixabay.py) --------------------
# Pixabay key (pixabay.com/api/docs). Enables the `pixabay` stock engine in images=auto.
PIXABAY_API_KEY=your-pixabay-api-key
# Optional: slugs (or `all`) allowed to use stock even when their style looks rendered
# STUDIO_PIXABAY_CHANNELS=

# --- Output -----------------------------------------------------------------
# Public, NON-expiring base URL that serves rendered media (platforms fetch from it;
# pre-signed URLs that expire will break scheduled posts). No trailing slash.
CDN_PUBLIC_BASE_URL=https://cdn.example.com/studio
STUDIO_OUTPUT_DIR=output
# Optional quality/resource controls (never put secrets in this file).
# Guarded launcher also sets CPU math-library worker pools to this value.
STUDIO_CPU_THREADS=3
# Lower-memory Z-Image generation size; final render still outputs 1080x1920.
STUDIO_ZIMAGE_SIZE=576x1024
STUDIO_ZIMAGE_STEPS=9
# Optional narration overrides; leave empty to use each brand's voice.
STUDIO_TTS_VOICE=
STUDIO_TTS_SPEED=
# Music is optional and must be supplied with a suitable licence under assets/music/.
STUDIO_MUSIC=0

# General short-video creator. Managed video is opt-in; never enabled by a client request.
# Export these to the web server process; the web server does not read this template.
STUDIO_CREATOR_CLOUD_ENABLED=0
REPLICATE_API_TOKEN=
# Optional OpenCode free-only model selection; discovered zero-price model otherwise.
STUDIO_CREATOR_FREE_MODEL=
# Lifetime application reservation ceiling; 0 keeps cloud generation unavailable.
STUDIO_CREATOR_CLOUD_BUDGET_USD=0
